rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /deals/{dealId} {
      allow read: if true;
      allow write: if false;
    }

    match /error_fares/{fareId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
